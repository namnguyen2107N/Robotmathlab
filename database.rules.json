{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['displayName', 'role'])"
        },
        "scores": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },
        "progress": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },
        "sessions": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "classrooms": {
      ".read": "auth != null",
      "$classroomId": {
        ".write": "auth != null && (!data.exists() || data.child('teacherUid').val() === auth.uid)",
        "students": {
          "$studentUid": {
            ".write": "auth != null && (auth.uid === $studentUid || data.parent().parent().child('teacherUid').val() === auth.uid)"
          }
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "global": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "byTask": {
        "$taskId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "system": {
      ".read": true,
      ".write": false
    }
  }
}
